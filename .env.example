# Context Graph POC configuration. Copy to .env and fill in.
# Nested settings use the CG_ prefix and __ as the delimiter.

CG_LOG_LEVEL=INFO
CG_LOG_FILE=logs/context_graph.log
# Pin a run id to resume an interrupted run; omit to start a fresh run.
# CG_RUN_ID=run_abc123

# What `context-graph` loads. Both are overridable with --input/--org-structure.
# CG_INPUT=data/convomem_demo/sessions.json         # default; any file of the same shape works
# CG_ORG_STRUCTURE=data/org_structure.json           # unset (default) skips org structure entirely

CG_NEO4J__URI=bolt://localhost:7687
CG_NEO4J__USER=neo4j
CG_NEO4J__PASSWORD=change-me
CG_NEO4J__DATABASE=neo4j

CG_MONGO__URI=mongodb://localhost:27017
CG_MONGO__DATABASE=context_graph

# NVIDIA NIM. Serves chat and embeddings. Same key as ai-graph-ingestion.
NVIDIA_API_KEY=change-me
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=nvidia/nemotron-3.5-bolt-e4b
# EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
# EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b

# Budgets and limits (provider-independent)
# CG_LLM__CONTEXT_LIMIT_TOKENS=10240   # default; sets the extraction batch size
# CG_LLM__MAX_OUTPUT_TOKENS=4000       # default; must hold a full batch of signals
# Must match the Neo4j vector index; changing it needs a fresh graph.
# 2048 is nvidia/nemotron-3.5-embed-1b.
CG_EMBEDDING__DIMENSION=2048

# Episode segmentation: how messages are grouped into episodes.
# llm_boundary (default) asks the model to propose topic boundaries.
# similarity groups by text size and splits where embedding similarity dips,
# without any LLM calls. Tune via CG_SEGMENTATION__SIMILARITY__* if used.
# CG_SEGMENTATION__STRATEGY=similarity

# --- Test conversation generator (test_conversation_generator/) ---
# Uses the NVIDIA settings above. Optional overrides:
# SYNTH_SEED=20260912
# SYNTH_OUTPUT_PATH=data/synthetic_sessions.json
# SYNTH_CONCURRENCY=4
# SYNTH_USER_COUNT=8
